{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@finance/shared-config": [
        "../packages/shared-config/index.ts"
      ],
      "@finance/shared-types": [
        "../packages/shared-types/index.ts"
      ],
      "@finance/shared-models": [
        "../packages/shared-models/index.ts"
      ],
      "@finance/shared-validation": [
        "../packages/shared-validation/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.test.ts"
  ]
}
