datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TransactionType {
  Income
  Expense
}

enum TransactionSource {
  Manual
  Import
  Receipt
}

enum BudgetPeriod {
  Weekly
  Monthly
  Yearly
}

enum Theme {
  Light
  Dark
  System
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  profile                 Profile?
  settings                UserSettings?
  categories              Category[]
  transactions            Transaction[]
  budgets                 Budget[]
  scoreHistory            ScoreHistory[]
  recommendations         Recommendation[]
  forecasts               Forecast[]
  aiInsights              AiInsight[]
  goals                   Goal[]
  emergencyFundSettings   EmergencyFundSettings?
  emergencyFundHistory    EmergencyFundHistory[]
  recurringItems          RecurringItem[]
  notificationCandidates  NotificationCandidate[]
  processedDocuments      ProcessedDocument[]
  exchangeAudits          ExchangeAudit[]
  notifications           Notification[]
  workflowJobs            WorkflowJob[]
  workflowHistory         WorkflowHistory[]
  financialScenarios      FinancialScenario[]
  assets                  Asset[]
  liabilities             Liability[]
  portfolios              Portfolio[]
  accounts                Account[]
  syncHistories           SyncHistory[]
  workspaceMembers        WorkspaceMember[]
  workspaceInvitations    WorkspaceInvitation[]
  conversations           Conversation[]
  offlineSyncQueues       OfflineSyncQueue[]
  Investment              Investment[]
  WatchlistItem           WatchlistItem[]
  RetirementPlan          RetirementPlan[]
  TaxRecord               TaxRecord[]
  InsurancePolicy         InsurancePolicy[]
  CollaborationInvitation CollaborationInvitation[]
  CollaboratorShare       CollaboratorShare[]
  ReviewRequest           ReviewRequest[]
  DeveloperExtension      DeveloperExtension[]
  BankConnection          BankConnection[]
  BusinessProfile         BusinessProfile[]
}

model Goal {
  id                           String             @id @default(cuid())
  userId                       String
  user                         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                         String
  description                  String?
  targetAmount                 Decimal            @db.Decimal(12, 2)
  currentAmount                Decimal            @default(0) @db.Decimal(12, 2)
  currency                     String             @default("USD")
  deadline                     DateTime?
  priority                     String             @default("medium")
  status                       String             @default("active")
  type                         String             @default("custom")
  estimatedMonthlyContribution Decimal?           @default(0) @db.Decimal(12, 2)
  actualMonthlyContribution    Decimal?           @default(0) @db.Decimal(12, 2)
  expectedCompletion           DateTime?
  forecastCompletion           DateTime?
  milestones                   GoalMilestone[]
  contributions                GoalContribution[]
  workspaceId                  String?
  workspace                    Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  portfolioId                  String?
  portfolio                    Portfolio?         @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([workspaceId])
}

model GoalMilestone {
  id         String    @id @default(cuid())
  goalId     String
  goal       Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  percentage Int
  amount     Decimal   @db.Decimal(12, 2)
  achievedAt DateTime?
  isCustom   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([goalId])
}

model GoalContribution {
  id          String   @id @default(cuid())
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  description String?
  createdAt   DateTime @default(now())

  @@index([goalId])
}

model Forecast {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      String
  scenario    String
  type        String
  data        Json
  confidence  Float?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, period, scenario])
}

model AiInsight {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  title          String
  summary        String
  detail         String
  contextVersion String
  promptVersion  String
  confidence     Float
  feedback       String?
  dismissed      Boolean  @default(false)
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, type])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  locale    String   @default("en-US")
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme              Theme    @default(System)
  emailNotifications Boolean  @default(false)
  aiInsightsEnabled  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Category {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      TransactionType
  color     String          @default("#6366f1")
  icon      String          @default("tag")
  isSystem  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  transactions   Transaction[]
  budgets        Budget[]
  recurringItems RecurringItem[]

  @@index([userId])
  @@index([userId, type])
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type        TransactionType
  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("USD")
  description String?
  date        DateTime          @default(now())
  source      TransactionSource @default(Manual)
  workspaceId String?
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([categoryId])
  @@index([workspaceId])
}

model Budget {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amount      Decimal      @db.Decimal(12, 2)
  period      BudgetPeriod @default(Monthly)
  startDate   DateTime     @default(now())
  workspaceId String?
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([workspaceId])
}

model ScoreHistory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month           String
  score           Int
  breakdown       Json
  recommendations Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId])
}

model Recommendation {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key            String
  category       String
  title          String
  summary        String
  explanation    String
  reason         String
  evidence       String
  monthlySavings Decimal   @db.Decimal(12, 2)
  annualSavings  Decimal   @db.Decimal(12, 2)
  scoreImpact    Int
  difficulty     String
  priority       String
  confidence     String
  action         String
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  expiresAt      DateTime?
  acceptedAt     DateTime?
  completedAt    DateTime?

  @@unique([userId, key])
  @@index([userId, status])
}

model EmergencyFundSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetMonths            Int      @default(6)
  customEssentialExpenses Decimal? @db.Decimal(12, 2)
  customReserve           Decimal? @db.Decimal(12, 2)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model EmergencyFundHistory {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month             String // e.g. "2026-07"
  coverageMonths    Decimal  @db.Decimal(6, 2)
  readinessScore    Int
  currentReserve    Decimal  @db.Decimal(12, 2)
  essentialExpenses Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  @@unique([userId, month])
}

model RecurringItem {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name             String
  type             TransactionType
  frequency        String // "Daily", "Weekly", "Biweekly", "Monthly", "Quarterly", "Semi-Annual", "Annual", "Custom"
  amount           Decimal         @db.Decimal(12, 2)
  expectedNextDate DateTime
  lastPaidDate     DateTime?
  status           String          @default("Active") // "Active", "Paused", "Completed", "Cancelled", "Overdue"
  confidence       Float           @default(1.0)
  isDetected       Boolean         @default(false)
  workspaceId      String?
  workspace        Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([workspaceId])
}

model NotificationCandidate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  sendAt    DateTime
  status    String   @default("Pending") // "Pending", "Sent", "Failed"
  type      String // e.g. "recurring_payment_reminder"
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, status])
}

model ProcessedDocument {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName        String
  fileType        String // "JPEG", "PNG", "WEBP", "PDF"
  fileSize        Int
  status          String   @default("uploaded") // "uploaded", "processing", "review_required", "confirmed", "failed"
  extractedData   Json? // Stores parsed fields and confidence scores
  confidenceScore Float    @default(0.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model ExchangeAudit {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       String // "IMPORT", "EXPORT", "BACKUP", "RESTORE"
  format       String // "CSV", "JSON", "PDF"
  dataset      String // "Transactions", "Categories", "All", etc.
  status       String // "success", "failed"
  recordCount  Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([userId, action])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String // "info", "warning", "critical", "success", "reminder", "recommendation", "achievement"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

model WorkflowJob {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  triggerType  String // "EVENT" or "CRON"
  triggerName  String // e.g. "transaction.created" or "0 0 * * *"
  status       String    @default("pending") // "pending", "running", "success", "failed"
  runCount     Int       @default(0)
  lastRun      DateTime?
  nextRun      DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([userId, status])
}

model WorkflowHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobName      String
  actionType   String
  status       String
  durationMs   Int
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model FinancialScenario {
  id                    String     @id @default(cuid())
  userId                String
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  type                  String // e.g. "BuyHouse", "BuyVehicle", "Retirement", "Startup", etc.
  description           String?
  startDate             DateTime
  durationMonths        Int
  priority              String // "high", "medium", "low"
  assumptions           String? // JSON stringified assumptions
  estimatedCost         Decimal    @db.Decimal(18, 2)
  expectedIncomeImpact  Decimal    @db.Decimal(18, 2)
  expectedExpenseImpact Decimal    @db.Decimal(18, 2)
  status                String     @default("Draft") // "Draft", "Planned", "Active", "Completed", "Archived", "Cancelled"
  workspaceId           String?
  workspace             Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([workspaceId])
}

model Asset {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  type             String // e.g. "Cash", "SavingsAccount", "CheckingAccount", "FixedDeposit", "Gold", "RealEstate", "Vehicle", "Stock", "MutualFund", "Crypto", "Custom"
  currentValue     Decimal    @db.Decimal(18, 2)
  purchaseValue    Decimal    @db.Decimal(18, 2)
  purchaseDate     DateTime
  appreciationRate Decimal    @db.Decimal(5, 2) // annual percentage, e.g. 5.50
  currency         String     @default("USD")
  ownership        String     @default("100") // owned percentage
  status           String     @default("Active") // "Active", "Sold", "Archived"
  notes            String?
  workspaceId      String?
  workspace        Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([workspaceId])
}

model Liability {
  id                 String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  type               String // e.g. "CreditCard", "PersonalLoan", "HomeLoan", "VehicleLoan", "EducationLoan", "Mortgage", "BNPL", "Custom"
  originalAmount     Decimal    @db.Decimal(18, 2)
  outstandingBalance Decimal    @db.Decimal(18, 2)
  interestRate       Decimal    @db.Decimal(5, 2) // annual interest rate, e.g. 8.50
  currency           String     @default("USD")
  lender             String
  emiAmount          Decimal    @db.Decimal(18, 2)
  repaymentFrequency String     @default("Monthly") // "Monthly", "Weekly", "Biweekly"
  nextDueDate        DateTime
  startDate          DateTime
  endDate            DateTime
  status             String     @default("Active") // "Active", "Closed", "Paused", "Overdue", "Defaulted", "Refinanced"
  notes              String?
  workspaceId        String?
  workspace          Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([workspaceId])
}

model Portfolio {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String // e.g. "Personal", "Business", "Retirement"
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  accounts    Account[]
  Investment  Investment[]
  Goal        Goal[]

  @@index([userId])
}

model Account {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioId    String?
  portfolio      Portfolio?   @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  name           String // e.g. "Cash Wallet", "Chase Savings", "Coinbase Crypto"
  institution    String // e.g. "Chase Bank", "Self"
  type           String // e.g. "CashWallet", "Checking", "Savings", "CreditCard", "Investment", "Crypto", "Custom"
  currency       String       @default("USD")
  openingBalance Decimal      @db.Decimal(18, 2)
  currentBalance Decimal      @db.Decimal(18, 2)
  status         String       @default("Active") // "Active", "Inactive", "Archived", "Closed", "PendingVerification"
  owner          String       @default("Self")
  metadata       String? // JSON string description
  workspaceId    String?
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Investment     Investment[]

  @@index([userId])
  @@index([portfolioId])
  @@index([workspaceId])
}

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String // e.g. "EUR"
  toCurrency   String // e.g. "USD"
  rate         Decimal  @db.Decimal(12, 6)
  date         DateTime @default(now())
  source       String   @default("Manual") // "Manual" or "Provider"

  @@index([fromCurrency, toCurrency, date])
}

model SyncHistory {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String // e.g. "MockProvider", "ManualCSV", "ManualJSON"
  status          String // "Started", "Completed", "Failed"
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  durationMs      Int?
  itemsImported   Int       @default(0)
  duplicatesFound Int       @default(0)
  warningsCount   Int       @default(0)
  errorsCount     Int       @default(0)
  logMessage      String?

  @@index([userId])
  @@index([userId, provider])
}

model Workspace {
  id              String                @id @default(cuid())
  name            String
  type            String                @default("Personal") // "Personal", "Couple", "Family", "Roommates", "Business", "Custom"
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  members         WorkspaceMember[]
  invitations     WorkspaceInvitation[]
  activityLogs    ActivityLog[]
  transactions    Transaction[]
  budgets         Budget[]
  goals           Goal[]
  accounts        Account[]
  liabilities     Liability[]
  assets          Asset[]
  recurringItems  RecurringItem[]
  scenarios       FinancialScenario[]
  RetirementPlan  RetirementPlan[]
  InsurancePolicy InsurancePolicy[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String // "Owner", "Administrator", "Editor", "Contributor", "Viewer", "Guest"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String // "Owner", "Administrator", "Editor", "Contributor", "Viewer", "Guest"
  status      String // "Pending", "Accepted", "Declined", "Expired", "Revoked"
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([email])
}

model ActivityLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  action      String // e.g. "Join", "CreateTransaction", "UpdateBudget"
  details     String
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("New Chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  feedback       String? // "Like" | "Dislike"
  agentType      String? // e.g. "Budget Coach"
  tokenUsage     Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model OfflineSyncQueue {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // "CreateTransaction", "UpdateBudget", etc.
  payload   String // JSON string
  status    String   @default("Pending") // "Pending", "Synced", "Failed"
  createdAt DateTime @default(now())

  @@index([userId])
}

model Investment {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  assetClass    String // e.g. "Stocks", "ETFs", "Gold", "Bonds", etc.
  ticker        String?
  accountId     String?
  account       Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  portfolioId   String?
  portfolio     Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  purchaseDate  DateTime
  purchasePrice Float
  quantity      Float
  currentValue  Float
  currency      String
  fees          Float      @default(0.0)
  notes         String?
  status        String     @default("Active") // "Active", "Sold", "Archived"
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  dividends     Dividend[]

  @@index([userId])
  @@index([portfolioId])
}

model Dividend {
  id                 String     @id @default(cuid())
  investmentId       String
  investment         Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  dividendDate       DateTime
  amount             Float
  currency           String
  taxWithheld        Float      @default(0.0)
  reinvestmentStatus String     @default("Payout") // "Payout", "Reinvested"
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([investmentId])
}

model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  ticker      String?
  targetPrice Float?
  priority    String   @default("Medium") // "High", "Medium", "Low"
  notes       String?
  status      String   @default("Active") // "Active", "Inactive"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model RetirementPlan {
  id                  String     @id @default(cuid())
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  profileType         String // "Early", "Traditional", "Semi", "Custom"
  currentAge          Int
  retirementAge       Int
  lifeExpectancy      Int
  currentSavings      Float
  monthlyContribution Float
  expectedExpenses    Float
  expectedReturn      Float
  expectedInflation   Float
  withdrawalStrategy  String
  currency            String
  workspaceId         String?
  workspace           Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([userId])
  @@index([workspaceId])
}

model TaxRecord {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taxYear      Int
  jurisdiction String
  type         String // "Income", "Expense", "Donation", "Investment"
  category     String // e.g. "Employment Income", "Charitable Donations", etc.
  amount       Float
  currency     String
  notes        String?
  tags         String? // comma-separated tags
  documentId   String? // optional link to a ProcessedDocument
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([taxYear])
}

model InsurancePolicy {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  carrier          String
  policyNumber     String?
  category         String // "Life", "Health", "Disability", "Property", "Liability", "Auto", "Custom"
  coverageAmount   Float
  premiumAmount    Float
  billingFrequency String // "Monthly", "Quarterly", "Annual", "One-Time"
  startDate        DateTime?
  expirationDate   DateTime?
  beneficiaries    String?
  notes            String?
  status           String     @default("Active") // "Active", "Lapsed", "Terminated"
  workspaceId      String?
  workspace        Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([userId])
  @@index([workspaceId])
}

model CollaborationInvitation {
  id          String   @id @default(cuid())
  email       String
  role        String // "Financial Planner", "Accountant", "Lawyer", "Family Member", "Business Partner", "Mentor", "Custom"
  status      String // "Pending", "Accepted", "Declined", "Expired", "Revoked"
  permissions String // comma-separated list of granted modules
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CollaboratorShare {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaboratorId String
  role           String
  permissions    String // comma-separated list of granted modules
  status         String   @default("Active") // "Active", "Suspended"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([collaboratorId])
}

model ReviewRequest {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaboratorId String // recipient reviewer user id
  title          String
  description    String
  module         String // "Retirement", "Investments", "Tax", "Insurance"
  status         String                 @default("Pending") // "Pending", "Reviewed", "Closed"
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  comments       CollaborationComment[]

  @@index([userId])
  @@index([collaboratorId])
}

model CollaborationComment {
  id              String        @id @default(cuid())
  reviewRequestId String
  reviewRequest   ReviewRequest @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)
  authorId        String // user id of the author
  content         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([reviewRequestId])
}

model CollaborationAudit {
  id        String   @id @default(cuid())
  userId    String
  action    String // e.g. "INVITATION_SENT", "PERMISSION_CHANGED", "DOWNLOAD_REPORT", "COMMENT_ADDED"
  details   String
  timestamp DateTime @default(now())

  @@index([userId])
}

model DeveloperExtension {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  version     String
  author      String
  description String?
  permissions String // comma-separated list
  status      String   @default("Disabled") // "Enabled", "Disabled"
  webhookUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(100)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BankConnection {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId   String
  institutionName String
  accessToken     String
  status          String   @default("Connected")
  lastSynced      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model HouseholdProfile {
  id        String            @id @default(cuid())
  name      String
  ownerId   String
  currency  String            @default("USD")
  timezone  String            @default("UTC")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   HouseholdMember[]
  splits    ExpenseSplit[]
}

model HouseholdMember {
  id          String           @id @default(cuid())
  householdId String
  household   HouseholdProfile @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  role        String           @default("Adult")
  createdAt   DateTime         @default(now())

  @@index([householdId])
}

model ExpenseSplit {
  id            String           @id @default(cuid())
  transactionId String
  householdId   String
  household     HouseholdProfile @relation(fields: [householdId], references: [id], onDelete: Cascade)
  splitType     String           @default("Equal")
  shares        String
  status        String           @default("Pending")
  createdAt     DateTime         @default(now())

  @@index([householdId])
}

model BusinessProfile {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  businessType String            @default("Freelance")
  currency     String            @default("USD")
  timezone     String            @default("UTC")
  taxId        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  clients      BusinessClient[]
  invoices     BusinessInvoice[]

  @@index([userId])
}

model BusinessClient {
  id         String            @id @default(cuid())
  businessId String
  business   BusinessProfile   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  notes      String?
  createdAt  DateTime          @default(now())
  invoices   BusinessInvoice[]

  @@index([businessId])
}

model BusinessInvoice {
  id         String          @id @default(cuid())
  businessId String
  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String
  client     BusinessClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount     Float
  status     String          @default("Draft")
  dueDate    DateTime
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([businessId])
  @@index([clientId])
}
