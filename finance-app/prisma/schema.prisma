datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TransactionType {
  Income
  Expense
}

enum TransactionSource {
  Manual
  Import
  Receipt
}

enum BudgetPeriod {
  Weekly
  Monthly
  Yearly
}

enum Theme {
  Light
  Dark
  System
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  profile      Profile?
  settings     UserSettings?
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  scoreHistory ScoreHistory[]
  recommendations Recommendation[]
  forecasts      Forecast[]
  aiInsights     AiInsight[]
  goals          Goal[]
  emergencyFundSettings EmergencyFundSettings?
  emergencyFundHistory  EmergencyFundHistory[]
  recurringItems        RecurringItem[]
  notificationCandidates NotificationCandidate[]
  processedDocuments    ProcessedDocument[]
}

model Goal {
  id                            String             @id @default(cuid())
  userId                        String
  user                          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                          String
  description                   String?
  targetAmount                  Decimal            @db.Decimal(12, 2)
  currentAmount                 Decimal            @default(0) @db.Decimal(12, 2)
  currency                      String             @default("USD")
  deadline                      DateTime?
  priority                      String             @default("medium")
  status                        String             @default("active")
  type                          String             @default("custom")
  estimatedMonthlyContribution  Decimal?           @default(0) @db.Decimal(12, 2)
  actualMonthlyContribution     Decimal?           @default(0) @db.Decimal(12, 2)
  expectedCompletion            DateTime?
  forecastCompletion            DateTime?
  milestones                    GoalMilestone[]
  contributions                 GoalContribution[]
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model GoalMilestone {
  id         String    @id @default(cuid())
  goalId     String
  goal       Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  percentage Int
  amount     Decimal   @db.Decimal(12, 2)
  achievedAt DateTime?
  isCustom   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([goalId])
}

model GoalContribution {
  id          String   @id @default(cuid())
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  description String?
  createdAt   DateTime @default(now())

  @@index([goalId])
}


model Forecast {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period         String
  scenario       String
  type           String
  data           Json
  confidence     Float?
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, period, scenario])
}

model AiInsight {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  title          String
  summary        String
  detail         String
  contextVersion String
  promptVersion  String
  confidence     Float
  feedback       String?
  dismissed      Boolean  @default(false)
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, type])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  locale    String   @default("en-US")
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme             Theme    @default(System)
  emailNotifications Boolean @default(false)
  aiInsightsEnabled Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Category {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      TransactionType
  color     String          @default("#6366f1")
  icon      String          @default("tag")
  isSystem  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  transactions Transaction[]
  budgets      Budget[]
  recurringItems RecurringItem[]

  @@index([userId])
  @@index([userId, type])
}

model Transaction {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type        TransactionType
  amount      Decimal          @db.Decimal(12, 2)
  currency    String           @default("USD")
  description String?
  date        DateTime         @default(now())
  source      TransactionSource @default(Manual)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([categoryId])
}

model Budget {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  categoryId String?
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amount     Decimal       @db.Decimal(12, 2)
  period     BudgetPeriod  @default(Monthly)
  startDate  DateTime      @default(now())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model ScoreHistory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month          String
  score          Int
  breakdown       Json
  recommendations Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId])
}

model Recommendation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key            String
  category       String
  title          String
  summary        String
  explanation     String
  reason         String
  evidence       String
  monthlySavings Decimal  @db.Decimal(12,2)
  annualSavings   Decimal  @db.Decimal(12,2)
  scoreImpact    Int
  difficulty     String
  priority       String
  confidence     String
  action         String
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime?
  acceptedAt     DateTime?
  completedAt    DateTime?

  @@unique([userId, key])
  @@index([userId, status])
}

model EmergencyFundSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetMonths            Int      @default(6)
  customEssentialExpenses Decimal? @db.Decimal(12, 2)
  customReserve           Decimal? @db.Decimal(12, 2)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model EmergencyFundHistory {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month             String   // e.g. "2026-07"
  coverageMonths    Decimal  @db.Decimal(6, 2)
  readinessScore    Int
  currentReserve    Decimal  @db.Decimal(12, 2)
  essentialExpenses Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  @@unique([userId, month])
}

model RecurringItem {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId           String?
  category             Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name                 String
  type                 TransactionType
  frequency            String        // "Daily", "Weekly", "Biweekly", "Monthly", "Quarterly", "Semi-Annual", "Annual", "Custom"
  amount               Decimal       @db.Decimal(12, 2)
  expectedNextDate     DateTime
  lastPaidDate         DateTime?
  status               String        @default("Active") // "Active", "Paused", "Completed", "Cancelled", "Overdue"
  confidence           Float         @default(1.0)
  isDetected           Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model NotificationCandidate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  sendAt    DateTime
  status    String   @default("Pending") // "Pending", "Sent", "Failed"
  type      String   // e.g. "recurring_payment_reminder"
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, status])
}

model ProcessedDocument {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName         String
  fileType         String   // "JPEG", "PNG", "WEBP", "PDF"
  fileSize         Int
  status           String   @default("uploaded") // "uploaded", "processing", "review_required", "confirmed", "failed"
  extractedData    Json?    // Stores parsed fields and confidence scores
  confidenceScore  Float    @default(0.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
}
